{{!
    @template tool_skills/profile_skills

    Panel of the user's skills in the Skills section of the user profile.

    The tool_skills/profiledisplay setting chooses between two displays. In the detailed display each
    skill is a Bootstrap 5 accordion panel: the header shows the skill summary
    (tool_skills/profile_skill_summary: current level image, name, level badge, earned/total points),
    followed by the pills added by plugins (tool_skills/profile_skill_pills; outside the accordion button,
    as they open a popover when tapped), and the body lists the courses that award the skill with their
    points and a link to the users-points report. In the totals-only display each skill is a static card
    with the summary, the pills, the learning time and the report link, without course and activity rows. The skill colour is
    validated to a #rgb/#rrggbb hex on input, so it is safe to interpolate it into the inline style.

    Classes required for JS:
    * none (Bootstrap collapse and popovers; both data-bs-* (Moodle 5.x) and data-* (Moodle 4.5) attributes are set)

    Context variables required for this template:
    * uniqid - Unique string to namespace the accordion element ids.
    * detailed - Whether to render the accordion with the course breakdown (true) or the totals only (false).
    * skills - Array of skills, each:
        * skillid, identitykey, name, hascolor, color
        * hascurrentlevel, currentlevelname, hascurrentlevelcolor, currentlevelcolor, currentleveltextcolor
        * haslevelimage, levelimageurl
        * earned, hastotalpoints, pointstocomplete
        * haspills, pills (name, label, title, variant)
        * haslearningtime, learningtime
        * hascourses, courses (coursename, courseurl, courseclass, haspoints, hasgoal, earned, available,
          iscomplete, hasaddoncontent, addoncontent)
        * hasreport, reporturl, hasbody, expanded

    Example context (json):
    {
        "uniqid": "abc123",
        "detailed": true,
        "skills": [
            {
                "skillid": 5,
                "identitykey": "myfirstskill",
                "name": "My first skill",
                "hascolor": true,
                "color": "#22c55e",
                "hascurrentlevel": true,
                "currentlevelname": "Level 2",
                "hascurrentlevelcolor": true,
                "currentlevelcolor": "#22c55e",
                "currentleveltextcolor": "#000000",
                "haslevelimage": true,
                "levelimageurl": "https://example.com/pluginfile.php/1/tool_skills/levelimage/12/badge.png",
                "earned": 10,
                "hastotalpoints": true,
                "pointstocomplete": 20,
                "haspills": true,
                "pills": [
                    {
                        "name": "skilladdon_decay",
                        "label": "−5 decay",
                        "title": "5 points removed by decay",
                        "variant": "warning"
                    }
                ],
                "haslearningtime": true,
                "learningtime": "90 days",
                "hascourses": true,
                "courses": [
                    {
                        "coursename": "My first 5.2 course",
                        "courseurl": "https://example.com/course/view.php?id=2",
                        "courseclass": "toolskill-course-first52",
                        "haspoints": false,
                        "hasgoal": false,
                        "earned": 0,
                        "available": 0,
                        "iscomplete": false,
                        "hasaddoncontent": false,
                        "addoncontent": ""
                    },
                    {
                        "coursename": "Kick 5.2",
                        "courseurl": "https://example.com/course/view.php?id=3",
                        "courseclass": "toolskill-course-kick52",
                        "haspoints": true,
                        "hasgoal": true,
                        "earned": 0,
                        "available": 33,
                        "iscomplete": false,
                        "hasaddoncontent": false,
                        "addoncontent": ""
                    }
                ],
                "hasreport": true,
                "reporturl": "https://example.com/admin/tool/skills/manage/usersreport.php?id=5",
                "hasbody": true,
                "expanded": true
            }
        ]
    }
}}
<div class="toolskills-profile-skills{{#detailed}} accordion{{/detailed}}{{^detailed}} toolskills-profile-totals{{/detailed}}" id="toolskills-accordion-{{uniqid}}">
    {{#skills}}
    <div class="{{#detailed}}accordion-item {{/detailed}}toolskill-card skill-{{identitykey}}"{{#hascolor}} style="border-inline-start: 4px solid {{color}};"{{/hascolor}}>
        {{#detailed}}
        <h3 class="accordion-header" id="toolskill-heading-{{uniqid}}-{{skillid}}">
            <button class="accordion-button{{^expanded}} collapsed{{/expanded}}" type="button"
                data-bs-toggle="collapse" data-bs-target="#toolskill-collapse-{{uniqid}}-{{skillid}}"
                data-toggle="collapse" data-target="#toolskill-collapse-{{uniqid}}-{{skillid}}"
                aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"
                aria-controls="toolskill-collapse-{{uniqid}}-{{skillid}}">
                {{> tool_skills/profile_skill_summary }}
            </button>
        </h3>
        {{#haspills}}
        <div class="toolskill-pills d-flex flex-wrap gap-2{{#haslevelimage}} toolskill-pills-indent{{/haslevelimage}}">
            {{> tool_skills/profile_skill_pills }}
        </div>
        {{/haspills}}
        <div id="toolskill-collapse-{{uniqid}}-{{skillid}}"
            class="accordion-collapse collapse{{#expanded}} show{{/expanded}}"
            aria-labelledby="toolskill-heading-{{uniqid}}-{{skillid}}"
            data-bs-parent="#toolskills-accordion-{{uniqid}}" data-parent="#toolskills-accordion-{{uniqid}}">
            <div class="accordion-body toolskill-body">
                {{#haslearningtime}}
                <p class="toolskill-learningtime text-muted mb-2">{{#str}}learningtime, tool_skills{{/str}}: {{learningtime}}</p>
                {{/haslearningtime}}
                {{#hascourses}}
                <ul class="toolskill-courses list-unstyled mb-2">
                    {{#courses}}
                    <li class="toolskill-course {{courseclass}} d-flex align-items-center justify-content-between gap-2 py-1">
                        <a href="{{courseurl}}">{{{coursename}}}</a>
                        {{#haspoints}}
                        <span class="badge rounded-pill toolskill-chip{{#iscomplete}} toolskill-chip-complete{{/iscomplete}}">{{earned}}{{#hasgoal}} / {{available}}{{/hasgoal}}</span>
                        {{/haspoints}}
                    </li>
                    {{#hasaddoncontent}}
                    <li class="toolskill-addon">{{{addoncontent}}}</li>
                    {{/hasaddoncontent}}
                    {{/courses}}
                </ul>
                {{/hascourses}}
                {{#hasreport}}
                <a class="toolskill-report" href="{{reporturl}}">{{#str}}usersreport, tool_skills{{/str}}</a>
                {{/hasreport}}
            </div>
        </div>
        {{/detailed}}
        {{^detailed}}
        <h3 class="toolskill-header">
            {{> tool_skills/profile_skill_summary }}
        </h3>
        {{#haspills}}
        <div class="toolskill-pills d-flex flex-wrap gap-2{{#haslevelimage}} toolskill-pills-indent{{/haslevelimage}}">
            {{> tool_skills/profile_skill_pills }}
        </div>
        {{/haspills}}
        {{#hasbody}}
        <div class="toolskill-body">
            {{#haslearningtime}}
            <p class="toolskill-learningtime text-muted mb-1">{{#str}}learningtime, tool_skills{{/str}}: {{learningtime}}</p>
            {{/haslearningtime}}
            {{#hasreport}}
            <a class="toolskill-report" href="{{reporturl}}">{{#str}}usersreport, tool_skills{{/str}}</a>
            {{/hasreport}}
        </div>
        {{/hasbody}}
        {{/detailed}}
    </div>
    {{/skills}}
</div>
